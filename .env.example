# X (Twitter) API v2 bearer token. Recent search needs the Basic tier or above.
X_BEARER_TOKEN=

# Where collected tweets and scores are stored
PLS_DB_PATH=data/pl_predictor.db

# Team keyword config
PLS_TEAMS_PATH=config/teams.yaml

# Hugging Face model used for scoring (must output negative / neutral / positive)
PLS_MODEL_NAME=cardiffnlp/twitter-roberta-base-sentiment-latest

# Collection window around kickoff, in minutes
PLS_PRE_MATCH_MINUTES=120
PLS_POST_MATCH_MINUTES=120

# Hard cap on tweets pulled per fixture per run (protects your monthly read quota)
PLS_MAX_TWEETS_PER_FIXTURE=500

# Max query length allowed by your API tier (512 on Basic, 4096 on Pro)
PLS_MAX_QUERY_LENGTH=512

# football-data.org API token (free at https://www.football-data.org/client/register)
FOOTBALL_DATA_ORG_TOKEN=

# Stage-2 study: only fixtures on/after this date count (set it to your first collection day).
# For the study also set PLS_PRE_MATCH_MINUTES=1440 and PLS_MAX_TWEETS_PER_FIXTURE=400.
PLS_SENTIMENT_SINCE=
# 1 = use the stage-2 sentiment model in predictions (only after `model study` passes).
PLS_STAGE2=0
